# Copy to .env for Docker Compose. Generate the token with: openssl rand -hex 32
EXTRACTOR_TOKEN=replace-with-a-long-random-token
EXTRACTOR_TIMEOUT_SECONDS=180

# Optional: route yt-dlp through a proxy.
# YTDLP_PROXY=socks5h://user:pass@host:1080

# Optional: cookies file. Mount it into the container if you use it.
# YTDLP_COOKIES_FILE=/cookies/cookies.txt
