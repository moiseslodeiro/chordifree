# Copy to /etc/chordifree-extractor.env and chmod 600.
# Generate the token with: openssl rand -hex 32
EXTRACTOR_TOKEN=replace-with-a-long-random-token

# Standalone yt-dlp armv7l binary (see the README).
YTDLP_PATH=/usr/local/bin/yt-dlp

# Optional: route yt-dlp through a proxy if this network is also challenged.
# YTDLP_PROXY=socks5h://user:pass@host:1080

# Optional: cookies file if YouTube still asks for a login.
# YTDLP_COOKIES_FILE=/etc/chordifree-extractor/cookies.txt

EXTRACTOR_TIMEOUT_SECONDS=180
