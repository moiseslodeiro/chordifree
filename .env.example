# Express API port
PORT=3001
# Allowed browser origin for direct API calls
CORS_ORIGIN=http://localhost:5173
# Internal analyzer URL
ANALYZER_URL=http://localhost:8000
# Operational limits
MAX_DURATION_SECONDS=900
MAX_UPLOAD_BYTES=26214400
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=3600000
# Number of trusted reverse-proxy hops in front of the API
TRUST_PROXY=1
# Temporary audio directory
TEMP_DIR=./.tmp
# System binaries
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Analyzer
ANALYZER_VERSION=essentia-1.6
# Download ONNX models on first analysis (set to 0 when models are baked into the image)
ANALYZER_DOWNLOAD_MODELS=1
