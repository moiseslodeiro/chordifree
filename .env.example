# Bind the API to loopback unless a reverse proxy needs it on the container network
HOST=127.0.0.1
# Express API port
PORT=3001
# Allowed browser origin for direct API calls
CORS_ORIGIN=http://localhost:5173
# Internal analyzer URL
ANALYZER_URL=http://localhost:8001
# Operational limits
MAX_DURATION_SECONDS=900
MAX_UPLOAD_BYTES=26214400
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=3600000
# Number of trusted reverse-proxy hops in front of the API
TRUST_PROXY=0
# Temporary audio directory
TEMP_DIR=./.tmp
# Temporary YouTube audio TTL in minutes. 0 keeps it until you clear it.
# If omitted, local installs keep it and remote installs expire it after 60 minutes.
# AUDIO_CACHE_TTL_MINUTES=60
# System binaries
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Analyzer
ANALYZER_VERSION=essentia-1.6
# Download ONNX models on first analysis (set to 0 when models are baked into the image)
ANALYZER_DOWNLOAD_MODELS=1

# Online mode -----------------------------------------------------------------
# Leave AUTH_MODE=none for local/desktop use. Set it to google to require a
# Google ID token and an entry in the allowlist.
AUTH_MODE=none
# OAuth 2.0 Web client ID. The server checks the ID token audience against it.
GOOGLE_CLIENT_ID=
# Comma-separated administrators. They are always allowed and can manage the
# allowlist from the web UI (#/admin).
ADMIN_EMAILS=
# GCP project used by Firestore (the allowlist and per-user libraries).
GOOGLE_CLOUD_PROJECT=
# Firestore database name. The default database is called (default).
FIRESTORE_DATABASE=(default)
# How the server authenticates against the analyzer: token or google.
# Use google on Cloud Run (the platform verifies the ID token).
ANALYZER_AUTH=token
# Shared token for the analyzer when ANALYZER_AUTH=token.
ANALYZER_TOKEN=
# Optional residential YouTube extractor (for example a Raspberry Pi at home).
# When set, the server sends YouTube probe/search/download requests there.
YOUTUBE_EXTRACTOR_URL=
YOUTUBE_EXTRACTOR_TOKEN=
YOUTUBE_EXTRACTOR_TIMEOUT_MS=240000
# Optional local stems plugin (desktop only). Directory with manifest.json and
# the separation command. See docs/STEMS_PLUGIN.md.
STEMS_PLUGIN_DIR=
# Optional remote stems service (wins over STEMS_PLUGIN_DIR). See docs/STEMS_PLUGIN.md.
STEMS_SERVICE_URL=
STEMS_SERVICE_TOKEN=
STEMS_SERVICE_TIMEOUT_MS=1800000
# Optional OpenTelemetry tracing to Google Cloud Trace (Cloud Run only).
OTEL_ENABLED=false
OTEL_SERVICE_NAME=chordifree-server
