# Puerto del servidor Express
PORT=3001
# Origen permitido para CORS (frontend en desarrollo)
CORS_ORIGIN=http://localhost:5173
# URL del microservicio analizador
ANALYZER_URL=http://localhost:8000
# Límites operativos
MAX_DURATION_SECONDS=900
MAX_UPLOAD_BYTES=26214400
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=3600000
# Directorio temporal para audio
TEMP_DIR=./.tmp
# Binarios del sistema
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Analizador
ANALYZER_VERSION=essentia-1.5
